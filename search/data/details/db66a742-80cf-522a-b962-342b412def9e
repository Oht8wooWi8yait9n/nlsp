        <h1>Clinical Aspects of Crew Health</h1>
        <div class="meta-id">Record ID: AP001</div>
      </div>

      <div class="content">
        <div class="action-banner">
          <div class="action-banner-text">
            <strong>Official Source:</strong> National Aeronautics and Space Administration Life Sciences Data Archive
          </div>
          <a href="https://nlsp.nasa.gov/search/data/details/db66a742-80cf-522a-b962-342b412def9e?dataType=EXPERIMENTS" target="_blank" rel="noopener noreferrer" class="btn">
