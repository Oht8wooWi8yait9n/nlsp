        <h1>Nutritional Intervention to Improve Muscle Protein Metabolism during Stress</h1>
        <div class="meta-id">Record ID: NAG91155</div>
      </div>

      <div class="content">
        <div class="action-banner">
          <div class="action-banner-text">
            <strong>Official Source:</strong> National Aeronautics and Space Administration Life Sciences Data Archive
          </div>
          <a href="https://nlsp.nasa.gov/search/data/details/951e4f2b-48a7-5159-8276-f9abf4997001?dataType=EXPERIMENTS" target="_blank" rel="noopener noreferrer" class="btn">
