        <h1>ATD (Anthropomorphic Test Dummy) Injury Metric Sensitivity and Extensibility Study</h1>
        <div class="meta-id">Record ID: ATD_Extensibility</div>
      </div>

      <div class="content">
        <div class="action-banner">
