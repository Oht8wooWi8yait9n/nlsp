        <h1>Microbiological Investigations of the Mir Space Station and Flight Crew (Phase 1A)</h1>
        <div class="meta-id">Record ID: 5.1</div>
      </div>

      <div class="content">
        <div class="action-banner">
          <div class="action-banner-text">
            <strong>Official Source:</strong> National Aeronautics and Space Administration Life Sciences Data Archive
          </div>
          <a href="https://nlsp.nasa.gov/search/data/details/75de6896-c51c-53c8-a184-8fa8fd092e72?dataType=EXPERIMENTS" target="_blank" rel="noopener noreferrer" class="btn">
